{
  "expo": {
    "name": "ReceiptGuard",
    "slug": "receiptguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "receiptguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "updates": {
      "enabled": false
    },
    "splash": {
      "backgroundColor": "#0B0F19"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "et.receiptguard.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "et.receiptguard.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ReceiptGuard uses the camera to scan receipt QR codes and photograph receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReceiptGuard needs access to your photos so you can verify a receipt you already saved."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://verify-receipt-app.vercel.app",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7f584f79-d39c-4be3-81e8-f8b54c114385"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
