{
  "expo": {
    "name": "Deresegn",
    "slug": "receiptguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "receiptguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "updates": {
      "enabled": false
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#0B0F19"
      }
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "et.receiptguard.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "et.receiptguard.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Deresegn uses the camera to scan receipt QR codes and photograph receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Deresegn needs access to your photos so you can verify a receipt you already saved."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://verify-receipt-app.vercel.app",
      "apkUrl": "https://verify-receipt-app.vercel.app/apk/deresegn.apk",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1ed9bf77-6cf0-4608-95de-7cfabfdbe1b3"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "alexanderkebe"
  }
}
